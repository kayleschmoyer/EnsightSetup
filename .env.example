# Google OAuth 2.0 Configuration
# Create credentials at: https://console.cloud.google.com/apis/credentials
#
# Required Google Cloud Console setup for the OAuth 2.0 Client ID:
#   1. Application type: Web application
#   2. Authorized JavaScript Origins: add http://localhost:5173
#      (The dev server is pinned to port 5173 in vite.config.js)
#   3. Save and wait a few minutes for changes to propagate
#
# "redirect_uri_mismatch" error = the origin where the app runs is not listed
# in Authorized JavaScript Origins for this Client ID.
#
# APIs to enable for this project (APIs & Services → Library):
#   - Google Drive API
#   - Google Sheets API  ← must be enabled on the SAME GCP project as VITE_GOOGLE_CLIENT_ID
#
# If Add Customer fails with "Sheets API has not been used in project …", open that
# exact project link from the error and click Enable. Propagation can take 1–2 minutes.
#
# OAuth scopes used by the app (configured in GoogleDriveService.js):
#   - https://www.googleapis.com/auth/drive
#   - https://www.googleapis.com/auth/spreadsheets
#   - email
#
# After changing scopes, users must sign out and sign in again with "Grant Drive Access"
# (consent prompt) so the new permissions are approved.

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_SHARED_FOLDER_ID=your-shared-drive-folder-id

# ---------------------------------------------------------------------------
# ClickUp feedback (server-side only — set these in Vercel Project → Settings →
# Environment Variables). Do NOT put CLICKUP_API_TOKEN in any VITE_ variable.
# ---------------------------------------------------------------------------
# CLICKUP_API_TOKEN=pk_your_personal_token
# CLICKUP_LIST_ID=901112174709
# CLICKUP_ASSIGNEE_EMAIL=kayle.schmoyer@ensight-technologies.com
#
# Optional: only needed for local Vite if the API is hosted on a different URL.
# VITE_CLICKUP_FEEDBACK_URL=https://your-deployment.vercel.app/api/create-clickup-task
