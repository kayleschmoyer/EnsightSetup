# This is a fork of garage-level-webapp being migrated to Supabase — see the
# repo root for MIGRATION notes. Copy this file to .env.local and fill it in.

# ---------------------------------------------------------------------------
# AWS RDS MySQL — server-side only, read by api/_db.js. NEVER prefix these
# with VITE_ (that would ship them into the client bundle). Schema lives at
# sql/schema.sql. Same vars must also be set in Vercel Project → Settings →
# Environment Variables (Production + Preview) for deployed environments.
# ---------------------------------------------------------------------------
DB_HOST=your-instance.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# ---------------------------------------------------------------------------
# Sign-in — Google Identity Services directly (see src/services/GoogleAuthService.js
# and api/auth-google.js), restricted server-side to @ensight-technologies.com
# accounts. Not Supabase Auth anymore. Authorized JavaScript Origins on this
# OAuth client must include http://localhost:3000 (the vercel dev port) and
# your deployed origin(s).
# ---------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-side only — signs/verifies the app's session cookie (api/_auth.js).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this invalidates every existing session.
SESSION_JWT_SECRET=generate-a-long-random-secret

# ---------------------------------------------------------------------------
# Supabase — Storage only now (floor-plan/device-photo buckets, see
# ImageUploadService.js). Customer data lives in MySQL/RDS above; auth is
# Google OAuth above. Project → Settings → API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (used by api/export-to-sheets.js, which still reads
# customer data from Supabase Postgres — not yet migrated to MySQL). Never
# put this in a VITE_ variable.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Google Cloud project APIs for the one-way "Export to Sheets" feature (Drive
# API, Sheets API) must still be enabled for the service account below —
# unrelated to the sign-in client above.
# ---------------------------------------------------------------------------

# Only needed for the optional/deferred "import a customer from an old
# Drive-linked spreadsheet" admin feature (OpenConfigFromDriveService.js) —
# not used by normal day-to-day usage.
# VITE_GOOGLE_SHARED_FOLDER_ID=your-shared-drive-folder-id

# ---------------------------------------------------------------------------
# Sheets export (server-side only — set in Vercel Project → Settings →
# Environment Variables, never as VITE_ vars). A Google service account (not
# the OAuth client above) writes the export, since a serverless function has
# no signed-in browser session to borrow a token from. Create one at
# console.cloud.google.com → IAM & Admin → Service Accounts, enable the Drive
# and Sheets APIs for its project, share GOOGLE_SHARED_FOLDER_ID with the
# service account's email as an Editor, then paste its JSON key below.
# ---------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}
# GOOGLE_SHARED_FOLDER_ID=your-shared-drive-folder-id
#
# Optional: only needed for local Vite if the API is hosted on a different URL.
# VITE_SHEETS_EXPORT_URL=https://your-deployment.vercel.app/api/export-to-sheets

# ---------------------------------------------------------------------------
# ClickUp feedback (server-side only — set these in Vercel Project → Settings →
# Environment Variables). Do NOT put CLICKUP_API_TOKEN in any VITE_ variable.
# ---------------------------------------------------------------------------
# CLICKUP_API_TOKEN=pk_your_personal_token
# CLICKUP_LIST_ID=901112174709
# CLICKUP_ASSIGNEE_EMAIL=kayle.schmoyer@ensight-technologies.com
#
# Optional: only needed for local Vite if the API is hosted on a different URL.
# VITE_CLICKUP_FEEDBACK_URL=https://your-deployment.vercel.app/api/create-clickup-task
