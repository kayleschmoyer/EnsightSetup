import React, { useRef, Suspense, Component } from 'react';
import { Canvas, useFrame } from '@react-three/fiber';
import { OrbitControls, Box, Edges, PerspectiveCamera, Html } from '@react-three/drei';

class Canvas3DErrorBoundary extends Component {
  state = { error: null };
  static getDerivedStateFromError(error) { return { error }; }
  render() {
    if (this.state.error) {
      return (
        <div className="flex-1 flex items-center justify-center text-sm text-red-400 p-8 text-center">
          <div>
            <p className="font-semibold mb-2">3D rendering error</p>
            <p className="text-xs text-muted-foreground">{this.state.error.message}</p>
          </div>
        </div>
      );
    }
    return this.props.children;
  }
}

const DEVICE_COLORS_HEX = {
  'cam-fli': '#3b82f6',
  'cam-lpr': '#8b5cf6',
  'cam-people': '#06b6d4',
  'sign-led': '#f59e0b',
  'sign-static': '#eab308',
  'sign-designable': '#f97316',
  'sensor-nwave': '#10b981',
  'sensor-parksol': '#14b8a6',
  'sensor-proco': '#22c55e',
  'sensor-ensight': '#34d399',
};

function FloorPlate({ y, level, isActive }) {
  return (
    <group position={[0, y, 0]}>
      <Box args={[20, 0.15, 14]}>
        <meshStandardMaterial
          color={isActive ? '#293138' : '#2d353c'}
          transparent
          opacity={isActive ? 0.8 : 0.4}
        />
        <Edges color={isActive ? '#348fe2' : '#495057'} />
      </Box>
      <Html position={[-9.5, 0.15, -6.5]} center={false} style={{ pointerEvents: 'none' }}>
        <span style={{ color: isActive ? '#93c5fd' : '#adb5bd', fontSize: 12, fontWeight: 600, whiteSpace: 'nowrap' }}>
          {level.name}
        </span>
      </Html>
    </group>
  );
}

function DeviceMarker({ device, baseY }) {
  const ref = useRef();
  const color = DEVICE_COLORS_HEX[device.type] || '#6b7280';

  // Normalize device positions to fit the floor scale
  const nx = ((device.x || 0) / 50) - 8;
  const nz = ((device.y || 0) / 50) - 5;
  const isCamera = device.type?.startsWith('cam-');
  const isSensor = device.type?.startsWith('sensor-');

  useFrame((state) => {
    if (ref.current) {
      ref.current.position.y = baseY + 0.3 + Math.sin(state.clock.elapsedTime * 2 + device.id) * 0.05;
    }
  });

  const size = isCamera ? [0.5, 0.5, 0.5] : isSensor ? [0.3, 0.3, 0.3] : [0.4, 0.6, 0.15];

  return (
    <group ref={ref} position={[nx, baseY + 0.3, nz]}>
      {isCamera ? (
        <mesh>
          <sphereGeometry args={[0.25, 16, 16]} />
          <meshStandardMaterial color={color} emissive={color} emissiveIntensity={0.3} />
        </mesh>
      ) : (
        <Box args={size}>
          <meshStandardMaterial color={color} emissive={color} emissiveIntensity={0.2} />
          <Edges color="white" />
        </Box>
      )}
    </group>
  );
}

function Scene({ levels, currentLevel, devices }) {
  const FLOOR_HEIGHT = 3.5;

  return (
    <>
      <PerspectiveCamera makeDefault position={[20, 15, 20]} fov={50} />
      <OrbitControls
        enableDamping
        dampingFactor={0.05}
        minDistance={10}
        maxDistance={50}
      />
      <ambientLight intensity={0.5} />
      <directionalLight position={[10, 20, 10]} intensity={1} />
      <pointLight position={[-10, 10, -10]} intensity={0.3} color="#348fe2" />

      {/* Floors */}
      {levels.map((level, i) => (
        <FloorPlate
          key={level.id}
          y={i * FLOOR_HEIGHT}
          level={level}
          isActive={level.id === currentLevel?.id}
        />
      ))}

      {/* Devices on current level */}
      {devices.map(device => {
        const levelIndex = levels.findIndex(l => l.id === currentLevel?.id);
        return (
          <DeviceMarker
            key={device.id}
            device={device}
            baseY={levelIndex * FLOOR_HEIGHT}
          />
        );
      })}

      {/* Ground plane */}
      <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, -0.2, 0]}>
        <planeGeometry args={[40, 30]} />
        <meshStandardMaterial color="#151c23" transparent opacity={0.5} />
      </mesh>
    </>
  );
}

export default function GarageViewer3D({ levels, currentLevel, devices }) {
  return (
    <div className="flex-1 flex flex-col">
      {/* Header */}
      <div className="px-4 py-3 border-b border-border bg-card/50 flex items-center justify-between">
        <div>
          <h3 className="text-sm font-semibold">3D Garage View</h3>
          <p className="text-xs text-muted-foreground">
            {levels.length} level{levels.length !== 1 ? 's' : ''} · {(devices || []).length} devices on current level
          </p>
        </div>
        <div className="flex items-center gap-2 text-xs text-muted-foreground">
          <span className="flex items-center gap-1">
            <span className="w-2 h-2 rounded-full bg-blue-500" />
            Cameras
          </span>
          <span className="flex items-center gap-1">
            <span className="w-2 h-2 rounded-full bg-amber-500" />
            Signs
          </span>
          <span className="flex items-center gap-1">
            <span className="w-2 h-2 rounded-full bg-emerald-500" />
            Sensors
          </span>
        </div>
      </div>

      {/* 3D Canvas */}
      <div className="flex-1 relative bg-[#151c23]">
        <div className="absolute inset-0">
          <Canvas3DErrorBoundary>
            <Canvas>
              <Scene levels={levels} currentLevel={currentLevel} devices={devices || []} />
            </Canvas>
          </Canvas3DErrorBoundary>
        </div>
      </div>
    </div>
  );
}
